{
  // Production overrides — no secrets here.
  // Sensitive values (connection string, API keys) come from /opt/smartboard/env
  // on the EC2, written by the GitHub Actions deploy workflow.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "KBot": {
    // KBot runs on the same EC2 — confirm the port with Mukesh.
    "BaseUrl": "http://localhost:8080"
  },
  "Savischools": {
    // Replace with the real Savischools API base URL.
    "BaseUrl": "https://api.savischools.savitroday.com",
    "Jwt": {
      // Replace with the real Savischools JWKS/authority URL.
      "Authority": "https://auth.savischools.savitroday.com",
      "Audience":  "smartboard-api"
    }
  },
  "Ai": {
    "BaseUrl": "https://api.openai.com",
    "Model":   "gpt-4o-mini",
    "MonthlyBudgetUsd": 50
  },
  "Cors": {
    // Replace with the real domain once DNS is pointed.
    "AllowedOrigins": [ "https://smartboard.savitroday.com" ]
  }
}
