{
    // Production overrides — no secrets here.
    // Sensitive values (connection string, API keys) come from /opt/smartboard/env
    // on the EC2, written by the GitHub Actions deploy workflow.
    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "Microsoft.Hosting.Lifetime": "Information"
            }
        }
    },
    "KBot": {
        // KBot API — https://kbot.svais.net/docs for interactive Swagger.
        "BaseUrl": "https://kbot.svais.net/api/v1/curriculum/"
    },
    "Savischools": {
        "BaseUrl": "https://api.savischools.com",
        "Jwt": {
            "Authority": "https://auth.savischools.com",
            "Audience": "smartboard-api"
        }
    },
    "Ai": {
        "ActiveProvider": "deepseek",
        "MonthlyBudgetUsd": 50,
        "Providers": {
            "deepseek":  { "BaseUrl": "https://api.deepseek.com",  "Model": "deepseek-v4-flash"           },
            "openai":    { "BaseUrl": "https://api.openai.com/v1", "Model": "gpt-4o-mini", "Vision": true },
            "anthropic": {                                          "Model": "claude-haiku-4-5", "Vision": true  }
        }
    },
    "S3": {
        "BucketName": "savismartboard-sessions",
        "Region": "ap-south-1"
    },
    "Cors": {
        "AllowedOrigins": [
            "https://teach.svais.net"
        ]
    },
    "DevJwt": {
        // Signing key for the hardcoded-login endpoint.
        // Override this via environment variable DevJwt__Key on the EC2 for production use.
        "Key": "SmartboardDevSigningKey-NotForProduction-32c"
    }
}